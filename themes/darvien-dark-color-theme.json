    "tokenColors": [
        {
            "scope": [
                "comment",
                "punctuation.definition.comment"
            ],
            "settings": {
                "foreground": "#85858B",
                "fontStyle": "italic"
            }
        },
        {
            "scope": [
                "comment.block.documentation",
                "comment.block.documentation.js",
                "comment.block.documentation.ts"
            ],
            "settings": {
                "foreground": "#8E9398",
                "fontStyle": "italic"
            }
        },
        {
            "scope": [
                "keyword",
                "keyword.control",
                "keyword.control.flow",
                "keyword.control.import",
                "keyword.control.export",
                "storage",
                "storage.type",
                "storage.modifier"
            ],
            "settings": {
                "foreground": "#D2769D"
            }
        },
        {
            "scope": [
                "keyword.operator",
                "keyword.operator.new",
                "keyword.operator.expression",
                "keyword.operator.logical"
            ],
            "settings": {
                "foreground": "#A88392"
            }
        },
        {
            "scope": [
                "string",
                "string.quoted",
                "string.quoted.single",
                "string.quoted.double",
                "string.template",
                "string.interpolated"
            ],
            "settings": {
                "foreground": "#55A783"
            }
        },
        {
            "scope": [
                "string.regexp",
                "string.regexp.character-class"
            ],
            "settings": {
                "foreground": "#D5A54B"
            }
        },
        {
            "scope": [
                "constant.numeric",
                "constant.language",
                "constant.character",
                "constant.other"
            ],
            "settings": {
                "foreground": "#9A68B0"
            }
        },
        {
            "scope": [
                "constant.language.boolean",
                "constant.language.null",
                "constant.language.undefined"
            ],
            "settings": {
                "foreground": "#9A68B0"
            }
        },
        {
            "scope": [
                "entity.name.function",
                "entity.name.function.method",
                "support.function",
                "meta.function-call",
                "variable.function",
                "entity.name.function.decorator"
            ],
            "settings": {
                "foreground": "#8099D1"
            }
        },
        {
            "scope": [
                "entity.name.type",
                "entity.name.class",
                "support.class",
                "support.type",
                "entity.name.struct",
                "entity.name.enum"
            ],
            "settings": {
                "foreground": "#D5A54B"
            }
        },
        {
            "scope": [
                "entity.name.namespace",
                "entity.name.module",
                "entity.name.package"
            ],
            "settings": {
                "foreground": "#C5A05A"
            }
        },
        {
            "scope": [
                "variable",
                "variable.other",
                "variable.other.readwrite",
                "variable.language",
                "variable.parameter"
            ],
            "settings": {
                "foreground": "#E7E7E9"
            }
        },
        {
            "scope": [
                "variable.other.constant",
                "variable.other.enummember"
            ],
            "settings": {
                "foreground": "#9A68B0"
            }
        },
        {
            "scope": [
                "entity.name.tag",
                "meta.tag",
                "punctuation.definition.tag"
            ],
            "settings": {
                "foreground": "#E66A62"
            }
        },
        {
            "scope": [
                "entity.other.attribute-name",
                "entity.other.attribute-name.class"
            ],
            "settings": {
                "foreground": "#8099D1"
            }
        },
        {
            "scope": [
                "punctuation",
                "punctuation.definition.parameters",
                "punctuation.definition.array",
                "punctuation.definition.dictionary",
                "meta.brace",
                "meta.brackets",
                "meta.delimiter"
            ],
            "settings": {
                "foreground": "#85858B"
            }
        },
        {
            "scope": [
                "punctuation.separator",
                "punctuation.terminator"
            ],
            "settings": {
                "foreground": "#68686D"
            }
        },
        {
            "scope": [
                "storage.type.function",
                "storage.type.class",
                "storage.type.interface"
            ],
            "settings": {
                "foreground": "#D2769D"
            }
        },
        {
            "scope": [
                "support.constant",
                "support.variable",
                "support.type.property-name"
            ],
            "settings": {
                "foreground": "#8099D1"
            }
        },
        {
            "scope": [
                "meta.property-name",
                "meta.object-literal.key",
                "support.type.property-name.json"
            ],
            "settings": {
                "foreground": "#8099D1"
            }
        },
        {
            "scope": [
                "entity.other.inherited-class"
            ],
            "settings": {
                "foreground": "#D5A54B"
            }
        },
        {
            "scope": [
                "markup.heading",
                "markup.heading.markdown"
            ],
            "settings": {
                "foreground": "#D2769D",
                "fontStyle": "bold"
            }
        },
        {
            "scope": [
                "markup.bold"
            ],
            "settings": {
                "foreground": "#E7E7E9",
                "fontStyle": "bold"
            }
        },
        {
            "scope": [
                "markup.italic"
            ],
            "settings": {
                "foreground": "#A1A1A6",
                "fontStyle": "italic"
            }
        },
        {
            "scope": [
                "markup.inline.raw",
                "markup.raw.inline"
            ],
            "settings": {
                "foreground": "#55A783"
            }
        },
        {
            "scope": [
                "markup.quote"
            ],
            "settings": {
                "foreground": "#A1A1A6"
            }
        },
        {
            "scope": [
                "markup.list"
            ],
            "settings": {
                "foreground": "#D2769D"
            }
        },
        {
            "scope": [
                "invalid",
                "invalid.illegal"
            ],
            "settings": {
                "foreground": "#F07A72",
                "fontStyle": "underline"
            }
        },
        {
            "scope": [
                "invalid.deprecated"
            ],
            "settings": {
                "foreground": "#D5A54B",
                "fontStyle": "underline"
            }
        }
    ],
    "semanticHighlighting": true,
    "semanticTokenColors": {
        "comment": "#85858B",
        "string": "#55A783",
        "number": "#9A68B0",
        "regexp": "#D5A54B",
        "keyword": "#D2769D",
        "operator": "#A88392",
        "variable": "#E7E7E9",
        "parameter": "#E7E7E9",
        "property": "#8099D1",
        "function": "#8099D1",
        "method": "#8099D1",
        "function.declaration": "#8099D1",
        "method.declaration": "#8099D1",
        "class": "#D5A54B",
        "interface": "#D5A54B",
        "struct": "#D5A54B",
        "enum": "#D5A54B",
        "type": "#D5A54B",
        "typeParameter": "#D5A54B",
        "namespace": "#C5A05A",
        "enumMember": "#9A68B0",
        "decorator": "#D2769D",
        "macro": "#D2769D",
        "label": "#D2769D",
        "event": "#E66A62"
    }
}