    "tokenColors": [
        {
            "scope": [
                "comment",
                "punctuation.definition.comment"
            ],
            "settings": {
                "foreground": "#636366",
                "fontStyle": "italic"
            }
        },
        {
            "scope": [
                "keyword",
                "keyword.control",
                "storage",
                "storage.type",
                "storage.modifier"
            ],
            "settings": {
                "foreground": "#FF7AB2"
            }
        },
        {
            "scope": [
                "keyword.operator"
            ],
            "settings": {
                "foreground": "#89DDFF"
            }
        },
        {
            "scope": [
                "string",
                "string.quoted",
                "string.template"
            ],
            "settings": {
                "foreground": "#A8E6CF"
            }
        },
        {
            "scope": [
                "constant.numeric",
                "constant.language",
                "constant.character"
            ],
            "settings": {
                "foreground": "#BA90D0"
            }
        },
        {
            "scope": [
                "entity.name.function",
                "support.function",
                "meta.function-call"
            ],
            "settings": {
                "foreground": "#82AAFF"
            }
        },
        {
            "scope": [
                "entity.name.type",
                "entity.name.class",
                "support.class",
                "support.type"
            ],
            "settings": {
                "foreground": "#FFD580"
            }
        },
        {
            "scope": [
                "variable",
                "variable.other",
                "variable.language"
            ],
            "settings": {
                "foreground": "#E5E5EA"
            }
        },
        {
            "scope": [
                "variable.parameter"
            ],
            "settings": {
                "foreground": "#C7C7CC"
            }
        },
        {
            "scope": [
                "entity.name.tag",
                "meta.tag"
            ],
            "settings": {
                "foreground": "#FF8A80"
            }
        },
        {
            "scope": [
                "entity.other.attribute-name"
            ],
            "settings": {
                "foreground": "#82AAFF"
            }
        },
        {
            "scope": [
                "support.constant",
                "support.variable"
            ],
            "settings": {
                "foreground": "#64D2FF"
            }
        },
        {
            "scope": [
                "invalid",
                "invalid.illegal"
            ],
            "settings": {
                "foreground": "#FF453A",
                "fontStyle": "underline"
            }
        },
        {
            "scope": [
                "punctuation",
                "meta.brace",
                "meta.brackets"
            ],
            "settings": {
                "foreground": "#8E8E93"
            }
        },
        {
            "scope": [
                "markup.heading",
                "markup.heading entity.name"
            ],
            "settings": {
                "foreground": "#FFFFFF",
                "fontStyle": "bold"
            }
        },
        {
            "scope": [
                "markup.bold"
            ],
            "settings": {
                "foreground": "#FFFFFF",
                "fontStyle": "bold"
            }
        },
        {
            "scope": [
                "markup.italic"
            ],
            "settings": {
                "foreground": "#D1D1D6",
                "fontStyle": "italic"
            }
        },
        {
            "scope": [
                "markup.inline.raw",
                "markup.raw"
            ],
            "settings": {
                "foreground": "#A8E6CF"
            }
        }
    ],
    "semanticHighlighting": true,
    "semanticTokenColors": {
        "namespace": "#C3E88D",
        "type": "#FFD580",
        "class": "#FFC86B",
        "enum": "#FF9F6B",
        "interface": "#5EEAD4",
        "struct": "#FFB4A2",
        "typeParameter": "#F5A9E1",
        "function": "#82AAFF",
        "method": "#5AC8FA",
        "parameter": "#FFCC99",
        "variable": "#E5E5EA",
        "property": "#7FDBCA",
        "enumMember": "#E0A3FF",
        "event": "#BF5AF2",
        "decorator": "#FF9F0A",
        "macro": "#FF6B35",
        "comment": "#45a843",
        "number": "#BA90D0",
        "string": "#A8E6CF",
        "keyword": "#FF7AB2",
        "modifier": "#FF9EC7",
        "regexp": "#F4B183",
        "operator": "#89DDFF",
        "variable.readonly": "#82E0FF",
        "*.deprecated": {
            "strikethrough": true
        }
    }
}