	"tokenColors": [
		{
			"scope": [
				"comment",
				"punctuation.definition.comment"
			],
			"settings": {
				"foreground": "#8E8E93",
				"fontStyle": "italic"
			}
		},
		{
			"scope": [
				"keyword",
				"keyword.control",
				"storage",
				"storage.type",
				"storage.modifier"
			],
			"settings": {
				"foreground": "#D12F7C"
			}
		},
		{
			"scope": [
				"keyword.operator"
			],
			"settings": {
				"foreground": "#007A99"
			}
		},
		{
			"scope": [
				"string",
				"string.quoted",
				"string.template"
			],
			"settings": {
				"foreground": "#1F8A65"
			}
		},
		{
			"scope": [
				"constant.numeric",
				"constant.language",
				"constant.character"
			],
			"settings": {
				"foreground": "#8944AB"
			}
		},
		{
			"scope": [
				"entity.name.function",
				"support.function",
				"meta.function-call"
			],
			"settings": {
				"foreground": "#2F5FD0"
			}
		},
		{
			"scope": [
				"entity.name.type",
				"entity.name.class",
				"support.class",
				"support.type"
			],
			"settings": {
				"foreground": "#B5750A"
			}
		},
		{
			"scope": [
				"variable",
				"variable.other",
				"variable.language"
			],
			"settings": {
				"foreground": "#1C1C1E"
			}
		},
		{
			"scope": [
				"variable.parameter"
			],
			"settings": {
				"foreground": "#48484A"
			}
		},
		{
			"scope": [
				"entity.name.tag",
				"meta.tag"
			],
			"settings": {
				"foreground": "#D6453D"
			}
		},
		{
			"scope": [
				"entity.other.attribute-name"
			],
			"settings": {
				"foreground": "#2F5FD0"
			}
		},
		{
			"scope": [
				"support.constant",
				"support.variable"
			],
			"settings": {
				"foreground": "#007A99"
			}
		},
		{
			"scope": [
				"invalid",
				"invalid.illegal"
			],
			"settings": {
				"foreground": "#D70015",
				"fontStyle": "underline"
			}
		},
		{
			"scope": [
				"punctuation",
				"meta.brace",
				"meta.brackets"
			],
			"settings": {
				"foreground": "#6E6E73"
			}
		},
		{
			"scope": [
				"markup.heading",
				"markup.heading entity.name"
			],
			"settings": {
				"foreground": "#000000",
				"fontStyle": "bold"
			}
		},
		{
			"scope": [
				"markup.bold"
			],
			"settings": {
				"foreground": "#000000",
				"fontStyle": "bold"
			}
		},
		{
			"scope": [
				"markup.italic"
			],
			"settings": {
				"foreground": "#3A3A3C",
				"fontStyle": "italic"
			}
		},
		{
			"scope": [
				"markup.inline.raw",
				"markup.raw"
			],
			"settings": {
				"foreground": "#1F8A65"
			}
		}
	],
	"semanticHighlighting": true,
	"semanticTokenColors": {
		"namespace": "#43C7AE",
		"type": "#17B585",
		"class": "#17B585",
		"enum": "#17B585",
		"interface": "#17B585",
		"struct": "#17B585",
		"typeParameter": "#17B585",
		"function": "#6B4ED1",
		"method": "#805FD6",
		"parameter": "#C16A24",
		"variable": "#1F2328",
		"property": "#536579",
		"enumMember": "#447FC0",
		"event": "#9957A8",
		"decorator": "#A961B8",
		"macro": "#C14A8C",
		"comment": "#71857C",
		"number": "#609456",
		"string": "#A17F16",
		"keyword": "#D04452",
		"modifier": "#C9515F",
		"regexp": "#CE5A43",
		"operator": "#687783",
		"variable.readonly": "#3C78B8",
		"*.deprecated": {
			"strikethrough": true
		}
	}
}