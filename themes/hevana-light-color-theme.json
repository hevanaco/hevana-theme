	"tokenColors": [
		{
			"scope": [
				"comment",
				"punctuation.definition.comment"
			],
			"settings": {
				"foreground": "#8E8E93",
				"fontStyle": "italic"
			}
		},
		{
			"scope": [
				"keyword",
				"keyword.control",
				"storage",
				"storage.type",
				"storage.modifier"
			],
			"settings": {
				"foreground": "#D21F67"
			}
		},
		{
			"scope": [
				"keyword.operator"
			],
			"settings": {
				"foreground": "#D21F67"
			}
		},
		{
			"scope": [
				"string",
				"string.quoted",
				"string.template"
			],
			"settings": {
				"foreground": "#16845C"
			}
		},
		{
			"scope": [
				"constant.numeric",
				"constant.language",
				"constant.character"
			],
			"settings": {
				"foreground": "#7C3AED"
			}
		},
		{
			"scope": [
				"entity.name.function",
				"support.function",
				"meta.function-call"
			],
			"settings": {
				"foreground": "#2457D6"
			}
		},
		{
			"scope": [
				"entity.name.type",
				"entity.name.class",
				"support.class",
				"support.type"
			],
			"settings": {
				"foreground": "#A05A00"
			}
		},
		{
			"scope": [
				"variable",
				"variable.other",
				"variable.language"
			],
			"settings": {
				"foreground": "#1C1C1E"
			}
		},
		{
			"scope": [
				"variable.parameter"
			],
			"settings": {
				"foreground": "#48484A"
			}
		},
		{
			"scope": [
				"entity.name.tag",
				"meta.tag"
			],
			"settings": {
				"foreground": "#C43D3D"
			}
		},
		{
			"scope": [
				"entity.other.attribute-name"
			],
			"settings": {
				"foreground": "#2457D6"
			}
		},
		{
			"scope": [
				"support.constant",
				"support.variable"
			],
			"settings": {
				"foreground": "#007A8A"
			}
		},
		{
			"scope": [
				"invalid",
				"invalid.illegal"
			],
			"settings": {
				"foreground": "#D70015",
				"fontStyle": "underline"
			}
		},
		{
			"scope": [
				"punctuation",
				"meta.brace",
				"meta.brackets"
			],
			"settings": {
				"foreground": "#6C6C70"
			}
		},
		{
			"scope": [
				"markup.heading",
				"markup.heading entity.name"
			],
			"settings": {
				"foreground": "#1C1C1E",
				"fontStyle": "bold"
			}
		},
		{
			"scope": [
				"markup.bold"
			],
			"settings": {
				"foreground": "#1C1C1E",
				"fontStyle": "bold"
			}
		},
		{
			"scope": [
				"markup.italic"
			],
			"settings": {
				"foreground": "#48484A",
				"fontStyle": "italic"
			}
		},
		{
			"scope": [
				"markup.inline.raw",
				"markup.raw"
			],
			"settings": {
				"foreground": "#16845C"
			}
		}
	],
	"semanticHighlighting": true,
	"semanticTokenColors": {
		"namespace": "#4D7C0F",
		"type": "#9A6700",
		"class": "#B45309",
		"enum": "#C2410C",
		"interface": "#0F7490",
		"struct": "#B84A2F",
		"typeParameter": "#A21CAF",
		"function": "#2457D6",
		"method": "#0369A1",
		"parameter": "#B85C00",
		"variable": "#1C1C1E",
		"property": "#087F75",
		"enumMember": "#7C3AED",
		"event": "#7026B9",
		"decorator": "#C2410C",
		"macro": "#B91C1C",
		"comment": "#45a843",
		"number": "#7C3AED",
		"string": "#16845C",
		"keyword": "#D21F67",
		"modifier": "#BE185D",
		"regexp": "#C2410C",
		"operator": "#087EA4",
		"variable.readonly": "#075FC4",
		"*.deprecated": {
			"strikethrough": true
		}
	}
}